// Writes Herb's C AST into a flat byte buffer, for bindings that can't create
// objects from C (like Ruby FFI on JRuby). lib/herb/ffi/deserialize.rb reads it
// back. Both files are generated from config.yml, so they agree on field order.
//
// Everything is a little-endian uint32 word, so Ruby can unpack the whole buffer
// at once. Booleans take a full word. A string is its length followed by its
// bytes, padded to the next word, and a length of UINT32_MAX means NULL. Anything
// that can be missing (node, error, token, location) starts with a presence word.
// Token types are written as numbers; Ruby looks up the names once at load time.
//
// Options travel the other way: Ruby fills in parser_options_T and
// herb_extract_ruby_options_T directly through FFI.

#define HERB_FFI_NULL_LENGTH UINT32_MAX

static void write_u32(hb_buffer_T* buffer, uint32_t value) {
  char bytes[4] = { value & 0xff, (value >> 8) & 0xff, (value >> 16) & 0xff, (value >> 24) & 0xff };
  hb_buffer_append_with_length(buffer, bytes, 4);
}

// uint32 is enough for lengths: hb_string_T already uses it, and only a Prism
// buffer for a multi-gigabyte template could go over.
static void write_data(hb_buffer_T* buffer, const void* data, size_t length) {
  static const char padding[3] = { 0 };

  if (data == NULL) {
    write_u32(buffer, HERB_FFI_NULL_LENGTH);
    return;
  }

  write_u32(buffer, (uint32_t) length);
  hb_buffer_append_with_length(buffer, data, length);
  hb_buffer_append_with_length(buffer, padding, (4 - length % 4) % 4);
}

static void write_string(hb_buffer_T* buffer, hb_string_T string) {
  write_data(buffer, string.data, string.length);
}

static void write_location(hb_buffer_T* buffer, location_T location) {
  write_u32(buffer, location.start.line);
  write_u32(buffer, location.start.column);
  write_u32(buffer, location.end.line);
  write_u32(buffer, location.end.column);
}

static void write_token(hb_buffer_T* buffer, const token_T* token, bool track_locations) {
  write_u32(buffer, token != NULL);
  if (token == NULL) { return; }

  write_string(buffer, token->value);
  write_u32(buffer, track_locations);

  if (track_locations) {
    write_u32(buffer, token->range.from);
    write_u32(buffer, token->range.to);
    write_location(buffer, token->location);
  }

  write_u32(buffer, (uint32_t) token->type);
}

static void write_prism_node(hb_buffer_T* buffer, herb_prism_node_T prism_node) {
  if (prism_node.node == NULL || prism_node.parser == NULL) {
    write_u32(buffer, HERB_FFI_NULL_LENGTH);
    return;
  }

  pm_buffer_t pm_buffer = { 0 };
  pm_serialize(prism_node.parser, prism_node.node, &pm_buffer);
  write_data(buffer, pm_buffer.value, pm_buffer.length);
  pm_buffer_free(&pm_buffer);
}

static void write_error(hb_buffer_T* buffer, ERROR_T* error) {
  write_u32(buffer, error != NULL);
  if (error == NULL) { return; }

  write_u32(buffer, (uint32_t) error->type);
  write_location(buffer, error->location);
  write_string(buffer, error->message);

  switch (error->type) {
  <%- errors.each do |error| -%>
    case <%= error.type %>: {
      <%- if error.fields.any? -%>
      <%= error.struct_type %>* <%= error.human %> = (<%= error.struct_type %>*) error;
      <%- end -%>
      <%- error.fields.each do |field| -%>
      <%- case field -%>
      <%- when Herb::Template::PositionField -%>
      write_u32(buffer, <%= error.human %>-><%= field.name %>.line);
      write_u32(buffer, <%= error.human %>-><%= field.name %>.column);
      <%- when Herb::Template::TokenField -%>
      write_token(buffer, <%= error.human %>-><%= field.name %>, true);
      <%- when Herb::Template::TokenTypeField -%>
      write_u32(buffer, (uint32_t) <%= error.human %>-><%= field.name %>);
      <%- when Herb::Template::StringField -%>
      // Ruby gets "" here rather than nil, same as the C extension (rb_utf8_str_new)
      write_string(buffer, hb_string_is_null(<%= error.human %>-><%= field.name %>) ? HB_STRING_EMPTY : <%= error.human %>-><%= field.name %>);
      <%- when Herb::Template::SizeTField -%>
      write_u32(buffer, (uint32_t) <%= error.human %>-><%= field.name %>);
      <%- else -%>
      #error "Unhandled error field type <%= field.class.name %>"
      <%- end -%>
      <%- end -%>
      break;
    }
  <%- end -%>
  }
}

static void write_errors(hb_buffer_T* buffer, hb_array_T* array) {
  size_t size = array ? hb_array_size(array) : 0;
  write_u32(buffer, (uint32_t) size);

  for (size_t index = 0; index < size; index++) {
    write_error(buffer, hb_array_get(array, index));
  }
}

static void write_node(hb_buffer_T* buffer, AST_NODE_T* node, const parser_options_T* options);

static void write_nodes(hb_buffer_T* buffer, hb_array_T* array, const parser_options_T* options) {
  size_t size = array ? hb_array_size(array) : 0;
  write_u32(buffer, (uint32_t) size);

  for (size_t index = 0; index < size; index++) {
    write_node(buffer, hb_array_get(array, index), options);
  }
}

static void write_node(hb_buffer_T* buffer, AST_NODE_T* node, const parser_options_T* options) {
  write_u32(buffer, node != NULL);
  if (node == NULL) { return; }

  write_u32(buffer, (uint32_t) node->type);
  write_u32(buffer, options->track_locations);
  if (options->track_locations) { write_location(buffer, node->location); }
  write_errors(buffer, node->errors);

  switch (node->type) {
  <%- nodes.each do |node| -%>
    case <%= node.type %>: {
      <%- if node.fields.any? -%>
      <%= node.struct_type %>* <%= node.human %> = (<%= node.struct_type %>*) node;
      <%- end -%>
      <%- node.fields.each do |field| -%>
      <%- case field -%>
      <%- when Herb::Template::StringField, Herb::Template::ElementSourceField -%>
      write_string(buffer, <%= node.human %>-><%= field.name %>);
      <%- when Herb::Template::NodeField, Herb::Template::BorrowedNodeField -%>
      write_node(buffer, (AST_NODE_T*) <%= node.human %>-><%= field.name %>, options);
      <%- when Herb::Template::TokenField -%>
      write_token(buffer, <%= node.human %>-><%= field.name %>, options->track_locations);
      <%- when Herb::Template::BooleanField -%>
      write_u32(buffer, <%= node.human %>-><%= field.name %>);
      <%- when Herb::Template::ArrayField -%>
      write_nodes(buffer, <%= node.human %>-><%= field.name %>, options);
      <%- when Herb::Template::LocationField -%>
      write_u32(buffer, options->track_locations && <%= node.human %>-><%= field.name %> != NULL);
      if (options->track_locations && <%= node.human %>-><%= field.name %> != NULL) { write_location(buffer, *<%= node.human %>-><%= field.name %>); }
      <%- when Herb::Template::PrismSerializedField -%>
      write_data(buffer, <%= node.human %>-><%= field.name %>.length ? <%= node.human %>-><%= field.name %>.data : NULL, <%= node.human %>-><%= field.name %>.length);
      <%- when Herb::Template::PrismNodeField -%>
      write_prism_node(buffer, <%= node.human %>-><%= field.name %>);
      <%- when Herb::Template::AnalyzedRubyField, Herb::Template::PrismContextField, Herb::Template::VoidPointerField -%>
      /* <%= field.name %> is internal parser state, so we skip it */
      <%- else -%>
      #error "Unhandled node field type <%= field.class.name %>"
      <%- end -%>
      <%- end -%>
      break;
    }
  <%- end -%>
  }
}

// Output uses malloc so Ruby can free it with herb_ffi_free.
static bool output_init(hb_buffer_T* buffer, hb_allocator_T* allocator, size_t capacity) {
  *allocator = hb_allocator_with_malloc();
  return hb_buffer_init(buffer, capacity, allocator);
}

static void output_finish(hb_buffer_T* buffer, uint8_t** out, size_t* out_length) {
  *out = (uint8_t*) buffer->value;
  *out_length = buffer->length;
}

HERB_EXPORTED_FUNCTION void herb_ffi_free(void* data) {
  free(data);
}

// Ruby allocates the option structs itself, so it compares sizes with these first.
HERB_EXPORTED_FUNCTION size_t herb_ffi_parser_options_size(void) {
  return sizeof(parser_options_T);
}

HERB_EXPORTED_FUNCTION size_t herb_ffi_extract_ruby_options_size(void) {
  return sizeof(herb_extract_ruby_options_T);
}

HERB_EXPORTED_FUNCTION void herb_ffi_parser_options_init(parser_options_T* options) {
  *options = HERB_DEFAULT_PARSER_OPTIONS;
}

HERB_EXPORTED_FUNCTION void herb_ffi_extract_ruby_options_init(herb_extract_ruby_options_T* options) {
  *options = HERB_EXTRACT_RUBY_DEFAULT_OPTIONS;
}

// The buffer stores token types as numbers. Ruby uses these to look up the names.
HERB_EXPORTED_FUNCTION uint32_t herb_ffi_token_type_count(void) {
  return TOKEN_EOF + 1;
}

HERB_EXPORTED_FUNCTION hb_string_T herb_ffi_token_type_name(uint32_t type) {
  return token_type_to_string((token_type_T) type);
}

HERB_EXPORTED_FUNCTION const hb_string_T* herb_ffi_default_erb_openings(size_t* count) {
  *count = HERB_DEFAULT_ERB_OPENINGS_COUNT;
  return HERB_DEFAULT_ERB_OPENINGS;
}

// Parses source and writes the serialized document to *out. A NULL source (nil
// in Ruby) parses as empty, like in the C extension. Returns false if we run out
// of memory.
HERB_EXPORTED_FUNCTION bool herb_ffi_parse(
  const char* source,
  const parser_options_T* options,
  uint8_t** out,
  size_t* out_length
) {
  hb_allocator_T allocator;
  hb_allocator_T output_allocator;
  hb_buffer_T output;

  if (!hb_allocator_init(&allocator, HB_ALLOCATOR_ARENA)) { return false; }

  if (!output_init(&output, &output_allocator, 4096)) {
    hb_allocator_destroy(&allocator);
    return false;
  }

  AST_DOCUMENT_NODE_T* root = herb_parse(source, options, &allocator);
  write_node(&output, (AST_NODE_T*) root, options);

  if (root != NULL) { ast_node_free((AST_NODE_T*) root, &allocator); }
  hb_allocator_destroy(&allocator);

  output_finish(&output, out, out_length);
  return true;
}

// Same as herb_ffi_parse, but writes the lexed tokens.
HERB_EXPORTED_FUNCTION bool herb_ffi_lex(
  const char* source,
  const parser_options_T* options,
  uint8_t** out,
  size_t* out_length
) {
  hb_allocator_T allocator;
  hb_allocator_T output_allocator;
  hb_buffer_T output;

  if (!hb_allocator_init(&allocator, HB_ALLOCATOR_ARENA)) { return false; }

  if (!output_init(&output, &output_allocator, 4096)) {
    hb_allocator_destroy(&allocator);
    return false;
  }

  hb_array_T* tokens = herb_lex_with_options(source, options, &allocator);
  size_t size = tokens ? hb_array_size(tokens) : 0;
  write_u32(&output, (uint32_t) size);

  for (size_t index = 0; index < size; index++) {
    write_token(&output, hb_array_get(tokens, index), true);
  }

  if (tokens != NULL) { herb_free_tokens(&tokens, &allocator); }
  hb_allocator_destroy(&allocator);

  output_finish(&output, out, out_length);
  return true;
}

// Extracts the Ruby from source, or the HTML when options is NULL. Returns a C
// string for the caller to free with herb_ffi_free, or NULL if something failed.
static char* extract(const char* source, const herb_extract_ruby_options_T* options) {
  hb_allocator_T allocator;
  hb_allocator_T output_allocator;
  hb_buffer_T output;

  if (!hb_allocator_init(&allocator, HB_ALLOCATOR_ARENA)) { return NULL; }

  if (!output_init(&output, &output_allocator, strlen(source))) {
    hb_allocator_destroy(&allocator);
    return NULL;
  }

  if (options != NULL) {
    herb_extract_ruby_to_buffer_with_options(source, &output, options, &allocator);
  } else {
    herb_extract_html_to_buffer(source, &output, &allocator);
  }

  hb_allocator_destroy(&allocator);

  return output.value;
}

HERB_EXPORTED_FUNCTION char* herb_ffi_extract_ruby(const char* source, const herb_extract_ruby_options_T* options) {
  return extract(source, options);
}

HERB_EXPORTED_FUNCTION char* herb_ffi_extract_html(const char* source) {
  return extract(source, NULL);
}

// Diffs two sources like Herb.diff. Writes whether the trees are identical, then
// for each operation: its type name, path, old and new node (parsed with the
// default options), and old and new index.
HERB_EXPORTED_FUNCTION bool herb_ffi_diff(
  const char* old_source,
  const char* new_source,
  bool track_whitespace_changes,
  uint8_t** out,
  size_t* out_length
) {
  herb_diff_options_T diff_options = HERB_DEFAULT_DIFF_OPTIONS;
  diff_options.track_whitespace_changes = track_whitespace_changes;

  hb_allocator_T allocator;
  hb_allocator_T output_allocator;
  hb_buffer_T output;

  if (!hb_allocator_init(&allocator, HB_ALLOCATOR_ARENA)) { return false; }

  if (!output_init(&output, &output_allocator, 4096)) {
    hb_allocator_destroy(&allocator);
    return false;
  }

  AST_DOCUMENT_NODE_T* old_root = herb_parse(old_source, &HERB_DEFAULT_PARSER_OPTIONS, &allocator);
  AST_DOCUMENT_NODE_T* new_root = herb_parse(new_source, &HERB_DEFAULT_PARSER_OPTIONS, &allocator);
  bool parsed = old_root != NULL && new_root != NULL;

  if (parsed) {
    herb_diff_result_T* result = herb_diff(old_root, new_root, &diff_options, &allocator);
    size_t count = herb_diff_operation_count(result);

    write_u32(&output, result->trees_identical);
    write_u32(&output, (uint32_t) count);

    for (size_t index = 0; index < count; index++) {
      const herb_diff_operation_T* operation = herb_diff_operation_at(result, index);
      const char* type = herb_diff_operation_type_to_string(operation->type);

      write_data(&output, type, strlen(type));
      write_u32(&output, operation->path.depth);

      for (uint16_t depth = 0; depth < operation->path.depth; depth++) {
        write_u32(&output, operation->path.indices[depth]);
      }

      write_node(&output, (AST_NODE_T*) operation->old_node, &HERB_DEFAULT_PARSER_OPTIONS);
      write_node(&output, (AST_NODE_T*) operation->new_node, &HERB_DEFAULT_PARSER_OPTIONS);
      write_u32(&output, operation->old_index);
      write_u32(&output, operation->new_index);
    }
  }

  if (old_root != NULL) { ast_node_free((AST_NODE_T*) old_root, &allocator); }
  if (new_root != NULL) { ast_node_free((AST_NODE_T*) new_root, &allocator); }
  hb_allocator_destroy(&allocator);

  if (!parsed) {
    free(output.value);
    return false;
  }

  output_finish(&output, out, out_length);
  return true;
}
